{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "electron/**/*",
    "src/types/**/*",
    "src/shared/**/*",
    "src/test/temp-db-tracker.ts",
    "../../packages/database/src/**/*"
  ],
  "exclude": [
    "electron/main/services/__tests__/benchmark.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "outDir": "./out",
    "rootDir": "../..",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./shared/*"],
      "@/*": ["./src/*"],
      "@hidock/database": ["../../packages/database/src/index.ts"]
    }
  }
}
