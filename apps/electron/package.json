{
  "name": "hidock-next",
  "version": "2.0.0",
  "description": "HiDock Next 2.0 — a private, local-first knowledge workspace for recordings and connected information.",
  "main": "./out/main/index.js",
  "author": "HiDock Next contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && node scripts/preflight-package.mjs && electron-builder --dir",
    "build:win": "npm run build && node scripts/preflight-package.mjs && electron-builder --win",
    "build:mac": "npm run build && node scripts/preflight-package.mjs && electron-builder --mac",
    "build:linux": "npm run build && node scripts/preflight-package.mjs && electron-builder --linux",
    "lint": "eslint .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild:electron": "node scripts/rebuild-electron.mjs",
    "check:native": "node scripts/dev/check-native.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:performance": "vitest run src/__tests__/performance"
  },
  "dependencies": {
    "@azure/msal-node": "^5.4.0",
    "@google/genai": "^2.19.0",
    "@google/generative-ai": "^0.21.0",
    "@hidock/ai-providers": "file:../../packages/ai-providers",
    "@hidock/calendar-sync": "file:../../packages/calendar-sync",
    "@hidock/connectors": "file:../../packages/connectors",
    "@hidock/connectors-slack": "file:../../packages/connectors-slack",
    "@hidock/database": "file:../../packages/database",
    "@hidock/jensen-protocol": "file:../../packages/jensen-protocol",
    "@hidock/knowledge-graph": "file:../../packages/knowledge-graph",
    "@hidock/transcription": "file:../../packages/transcription",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-virtual": "^3.14.13",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ffmpeg-static": "^5.3.0",
    "ical.js": "^2.1.0",
    "lucide-react": "^0.460.0",
    "ollama": "^0.5.11",
    "onnxruntime-node": "1.30.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.27.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.11.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "usb": "^2.17.0",
    "uuid": "^11.0.3",
    "zod": "^4.1.13",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint-react/eslint-plugin": "^5.23.5",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@types/uuid": "^10.0.0",
    "@types/w3c-web-usb": "^1.0.13",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.1",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "onnxruntime-node": "1.30.0",
    "@electron/asar": "^4.3.1",
    "fast-uri": "^3.1.8",
    "ip-address": "^10.4.0",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.16",
    "undici": "^6.28.1",
    "tar": "^7.5.7",
    "react-router": "^7.18.2",
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.0",
    "brace-expansion@^2": "^2.1.7",
    "brace-expansion@^5": "^5.0.12",
    "app-builder-lib": {
      "@electron/get": "^5.1.0"
    }
  },
  "//": [
    "overrides.app-builder-lib.@electron/get: electron-builder 26.x pins @electron/get ^3, which pulls got 11 -> cacheable-request 7 -> http-cache-semantics 4.2.0 (GHSA-ch52-4w7c-c8xp, no patched release). @electron/get 5 downloads with fetch and drops got. Remove this override once electron-builder 27 is stable (27 depends on @electron/get ^5 itself).",
    "overrides.onnxruntime-node: one onnxruntime-node build for the app and @huggingface/transformers (which pins its own exact version). 1.30.0 matches transformers 4.3 and uses global-agent 4, which drops the deprecated boolean package that 1.24.3 pulled through global-agent 3.",
    "overrides.@electron/asar: app-builder-lib 26.x pins @electron/asar 3.4.1, which pulls glob 7 and inflight (both deprecated). app-builder-lib already loads asar through a dynamic import, so the ESM-only asar 4 works; @electron/universal (macOS universal builds) and electron-winstaller (Squirrel, unused: the Windows target is NSIS) get the same version. Remove once electron-builder ships asar 4 itself.",
    "allowScripts.better-sqlite3 false: since 13.0 the package ships Node-API prebuilts (prebuilds/<platform>-<arch>.node) that load under Node and Electron. npm sees its binding.gyp and would run node-gyp rebuild, which builds nothing when a prebuilt exists; false skips it (same in packages/database and packages/knowledge-graph)."
  ],
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "better-sqlite3": false,
    "electron-winstaller@5.4.0": true,
    "esbuild": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs": false,
    "usb@2.17.0": true,
    "@google/genai": false,
    "file:../../../../packages/connectors-slack": true,
    "file:../../../../packages/database": true,
    "file:../../../../packages/connectors": true,
    "file:../../../../packages/jensen-protocol": true,
    "file:../../../../packages/knowledge-graph": true
  }
}
